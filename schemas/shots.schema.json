{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShotsSchema",
  "description": "Browser automation recording script schema for screendemo shoot.py",
  "type": "object",
  "required": ["profile", "viewport", "shots"],
  "properties": {
    "profile": {
      "type": "string"
    },
    "viewport": {
      "type": "array",
      "items": {"type": "integer"},
      "minItems": 2,
      "maxItems": 2
    },
    "shots": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["steps"],
        "properties": {
          "note": {"type": "string"},
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["do"],
              "properties": {
                "do": {
                  "type": "string",
                  "enum": [
                    "goto", "wait", "click", "hover", "type", "press", "key",
                    "mark", "snap", "start", "top", "scroll_to", "focus", "ink",
                    "hide_ads", "dismiss_dialogs", "settle"
                  ]
                },
                "url": {"type": "string"},
                "sec": {"type": "number"},
                "target": {
                  "oneOf": [
                    {"type": "string"},
                    {
                      "type": "object",
                      "properties": {
                        "css": {"type": "string"},
                        "has_text": {"type": "string"},
                        "text": {"type": "string"},
                        "exact": {"type": "boolean"},
                        "nth": {"type": "integer"},
                        "last": {"type": "boolean"},
                        "role": {"type": "string"},
                        "name": {"type": "string"},
                        "after_label": {"type": "string"},
                        "frame": {"type": "string"}
                      }
                    }
                  ]
                },
                "name": {"type": "string"},
                "text": {"type": "string"},
                "dur": {"type": "number"},
                "frac": {"type": "number"},
                "hold": {"type": "number"},
                "cps": {"type": "array", "items": {"type": "number"}},
                "clear": {"type": "boolean"},
                "enter": {"type": "boolean"},
                "wait": {"type": "number"}
              },
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}
