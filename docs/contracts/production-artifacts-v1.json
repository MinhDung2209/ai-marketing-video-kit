{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-marketing-video-kit:production-artifacts:v1",
  "title": "Production artifact manifest v1",
  "description": "Per-stage tool/artifact receipt only. KWF product-demo and workflow.json retain workflow, gate and scheduling authority. x-kwf-stage-mapping is a checked projection, never a replacement definition.",
  "x-authoritative-workflow": {
    "path": "D:/Projects/kit-studio/docs/workflows/product-demo.json",
    "id": "product-demo",
    "version": 1,
    "sha256": "3536d3f46d00bb83cd0f51bab54f2e46f916cb193f2d4efcdf8cc9b05543c64c",
    "approval_implementation": "D:/Projects/kit-studio/backend/workflow/check.mjs#approvalDigest"
  },
  "x-kwf-stage-mapping": [
    {
      "stage_id": "brief",
      "role": "producer",
      "kwf_required_files": [
        "brief.md"
      ],
      "kwf_evidence_file": "workflow-evidence/brief.json",
      "kwf_checklist": [
        "scope_confirmed"
      ],
      "kwf_approval": false,
      "kit_producers_or_existing_owners": [
        "Human / existing Studio brief surface"
      ],
      "kit_outputs": [
        "brief.md"
      ],
      "receipt_owner_notes": "Existing Studio owner records scope; no kit generator is implied."
    },
    {
      "stage_id": "research",
      "role": "researcher",
      "kwf_required_files": [
        "research.json"
      ],
      "kwf_evidence_file": "workflow-evidence/research.json",
      "kwf_checklist": [
        "read_only",
        "verified_numbers",
        "topic_sources_approved"
      ],
      "kwf_approval": false,
      "kit_producers_or_existing_owners": [
        "Human / existing read-only research flow"
      ],
      "kit_outputs": [
        "research.json",
        "research screenshots"
      ],
      "receipt_owner_notes": "Backend/agent writes the research receipt; no new browser or credential flow."
    },
    {
      "stage_id": "script",
      "role": "scriptwriter",
      "kwf_required_files": [
        "script.md",
        "voice.json"
      ],
      "kwf_evidence_file": "workflow-evidence/script.json",
      "kwf_checklist": [
        "hook_then_tool",
        "numbers_traceable",
        "pronunciation",
        "no_banned_phrases"
      ],
      "kwf_approval": false,
      "kit_producers_or_existing_owners": [
        "Human / existing scriptwriter"
      ],
      "kit_outputs": [
        "script.md",
        "voice.json"
      ],
      "receipt_owner_notes": "Preserve voice.lines[].caption overrides; no corpus import."
    },
    {
      "stage_id": "script-approval",
      "role": "owner",
      "kwf_required_files": [],
      "kwf_evidence_file": null,
      "kwf_checklist": [],
      "kwf_approval": true,
      "kit_producers_or_existing_owners": [
        "KWF trusted owner approve action"
      ],
      "kit_outputs": [
        "workflow.json approval"
      ],
      "receipt_owner_notes": "Kit only reads the approval reference; it cannot grant approval."
    },
    {
      "stage_id": "record",
      "role": "recorder",
      "kwf_required_files": [
        "recording.json"
      ],
      "kwf_evidence_file": "workflow-evidence/record.json",
      "kwf_checklist": [
        "sheets_viewed",
        "safe_actions_only",
        "numbers_match"
      ],
      "kwf_approval": false,
      "kit_producers_or_existing_owners": [
        "screendemo/shoot.py <work> --list",
        "screendemo/shoot.py <work> <approved-shot-ids>"
      ],
      "kit_outputs": [
        "assets/screen/<shot-id>/ recording and sheet.jpg"
      ],
      "receipt_owner_notes": "Studio backend/record owner writes recording.json linking actual recordings and reviewed sheets; shoot.py does not emit that receipt."
    },
    {
      "stage_id": "voice",
      "role": "voice-editor",
      "kwf_required_files": [
        "voice.json",
        "voice-review.json"
      ],
      "kwf_evidence_file": "workflow-evidence/voice.json",
      "kwf_checklist": [
        "owner_listened",
        "pronunciation",
        "phrase_timing"
      ],
      "kwf_approval": false,
      "kit_producers_or_existing_owners": [
        "tools/tts_script.py <voice.json> <audio-out> (only after service/owner authorization)",
        "screendemo/chunks.py (existing timing inspection)"
      ],
      "kit_outputs": [
        "<audio-out>/<line-id>.mp3",
        "<audio-out>/narration.mp3",
        "<audio-out>/timing.json"
      ],
      "receipt_owner_notes": "Existing tts_script.py emits timing.json, not voice-review.json. Voice owner keeps voice.json and records owner listen evidence in voice-review.json. Google is paused: report unavailable; optional VieNeu must be explicitly selected/authorized, never silently substituted."
    },
    {
      "stage_id": "build",
      "role": "editor",
      "kwf_required_files": [
        "build-manifest.json"
      ],
      "kwf_evidence_file": "workflow-evidence/build.json",
      "kwf_checklist": [
        "snapshots_viewed",
        "timing_checked"
      ],
      "kwf_approval": false,
      "kit_producers_or_existing_owners": [
        "screendemo/produce.py <work> --build --only full",
        "screendemo/produce.py <work> --snap 3,40,80 --only full",
        "screendemo/produce.py <work> --qa --qa-source build --only full"
      ],
      "kit_outputs": [
        "index.html",
        "cues.json",
        "qa/contact-sheet.jpg",
        "qa/checklist.md"
      ],
      "receipt_owner_notes": "Initial build only in the external work root. Backend/build owner writes build-manifest.json including build directory and hashes; produce.py does not emit that KWF receipt. --snap also runs story.py; it must not target the edited Studio master."
    },
    {
      "stage_id": "to-studio",
      "role": "studio-agent",
      "kwf_required_files": [
        "index.html",
        "studio.json",
        "voice.json"
      ],
      "kwf_evidence_file": "workflow-evidence/to-studio.json",
      "kwf_checklist": [
        "assets_resolve",
        "rules_preserved"
      ],
      "kwf_approval": false,
      "kit_producers_or_existing_owners": [
        "tools/to_studio.py <build> <clip>"
      ],
      "kit_outputs": [
        "index.html",
        "studio.json",
        "voice.json",
        "assets/"
      ],
      "receipt_owner_notes": "Initial transfer only; copy workflow-evidence sidecars independently without replacing them. Kit does not protect existing master edits automatically; caller must enforce owner permission. After transfer clip/index.html is master."
    },
    {
      "stage_id": "studio-qa",
      "role": "qa-agent",
      "kwf_required_files": [
        "index.html",
        "voice.json",
        "studio.json"
      ],
      "kwf_evidence_file": "workflow-evidence/studio-qa.json",
      "kwf_checklist": [
        "lint_reviewed",
        "snapshots_viewed",
        "numbers_verified",
        "no_provider_names",
        "no_agent_exposure",
        "mark_inventory_verified",
        "voice_caption_match",
        "hook_then_tool",
        "gsap_timing_checked"
      ],
      "kwf_approval": false,
      "kit_producers_or_existing_owners": [
        "Existing Studio QA",
        "npx hyperframes lint",
        "npx hyperframes snapshot . --at <review-times>"
      ],
      "kit_outputs": [
        "QA snapshots",
        "workflow-evidence/studio-qa.json"
      ],
      "receipt_owner_notes": "Use edited clip/index.html. Existing QA owner writes all exact KWF checklist keys, firstSceneEnd, inkTimes, stickerTimes and human review evidence. Optional QA adapters supplement this receipt."
    },
    {
      "stage_id": "owner-review",
      "role": "owner",
      "kwf_required_files": [],
      "kwf_evidence_file": null,
      "kwf_checklist": [],
      "kwf_approval": true,
      "kit_producers_or_existing_owners": [
        "KWF trusted owner approve action"
      ],
      "kit_outputs": [
        "workflow.json approval"
      ],
      "receipt_owner_notes": "Owner watches/listens to current Studio master. Reference actual KWF approval, never synthesize owner approval from a tool success."
    },
    {
      "stage_id": "render",
      "role": "render-agent",
      "kwf_required_files": [
        "renders/final.mp4",
        "render-review.json"
      ],
      "kwf_evidence_file": "workflow-evidence/render.json",
      "kwf_checklist": [
        "mp4_frames_viewed",
        "duration_checked",
        "audio_checked",
        "master_matches"
      ],
      "kwf_approval": false,
      "kit_producers_or_existing_owners": [
        "KWF command: npx hyperframes render -o renders/final.mp4 -q delivery",
        "tools/render.py (existing kit build renderer; distinct output path)"
      ],
      "kit_outputs": [
        "renders/final.mp4",
        "render-review.json"
      ],
      "receipt_owner_notes": "Studio backend/render owner invokes configured renderer for approved master and writes render-review.json with master hash, actual MP4 frame/audio/probe evidence. Do not treat pre-transfer final/<slug>-<variant>.mp4 as this approved Studio render. Optional render_hyperframes.py is picture-only until audio parity is verified."
    },
    {
      "stage_id": "publish-package",
      "role": "publisher",
      "kwf_required_files": [
        "publish-package.json"
      ],
      "kwf_evidence_file": "workflow-evidence/publish-package.json",
      "kwf_checklist": [
        "package_complete",
        "no_upload"
      ],
      "kwf_approval": false,
      "kit_producers_or_existing_owners": [
        "Existing Studio/backend local packaging owner"
      ],
      "kit_outputs": [
        "publish-package.json",
        "local MP4/title/description/CTA/thumbnail/credits"
      ],
      "receipt_owner_notes": "Packaging owner writes publish-package.json with file hashes and attribution. tools/make_package.py packages the kit distribution, not this clip delivery. No upload/post action is implied."
    }
  ],
  "x-status-semantics": {
    "succeeded": "Invocation completed and promised artifacts were verified; this does not mark the KWF stage done or constitute human approval.",
    "failed": "Invocation ran but failed, including malformed output or missing required artifacts.",
    "unavailable": "Selected optional executable/module/model/platform or paused service is absent/unusable; no invocation, no output artifacts and no automatic provider fallback.",
    "cancelled": "Caller/system cancelled; retain diagnostic partial files outside the accepted artifacts, release owned resources, and require scheduler/owner decision before retry.",
    "timed_out": "Configured deadline elapsed; terminate only processes owned by this invocation, release resources, and retain diagnostics."
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "manifest_id",
    "clip_id",
    "stage_id",
    "workflow",
    "roots",
    "attempt",
    "input_hashes",
    "artifacts",
    "tool_results",
    "review_evidence",
    "approval_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "production-artifacts-v1"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "clip_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "enum": [
        "brief",
        "research",
        "script",
        "script-approval",
        "record",
        "voice",
        "build",
        "to-studio",
        "studio-qa",
        "owner-review",
        "render",
        "publish-package"
      ]
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "definition_sha256",
        "state_revision"
      ],
      "properties": {
        "id": {
          "const": "product-demo"
        },
        "version": {
          "const": 1
        },
        "definition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "state_revision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clip",
        "work"
      ],
      "properties": {
        "clip": {
          "type": "string",
          "minLength": 1
        },
        "work": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "owner",
        "started_at",
        "finished_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "input_hashes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      },
      "minItems": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      },
      "minItems": 0
    },
    "tool_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool_result"
      },
      "minItems": 1
    },
    "review_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      },
      "minItems": 0
    },
    "approval_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval"
      },
      "minItems": 0
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "root": {
          "enum": [
            "clip",
            "work"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\r\\n]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tool_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tool",
        "version_or_pin",
        "status",
        "exit_code",
        "message",
        "artifact_paths",
        "error"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "version_or_pin": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "unavailable",
            "cancelled",
            "timed_out"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "artifact_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "message",
                "remediation"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                },
                "remediation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 0
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "type": "null"
              },
              "artifact_paths": {
                "maxItems": 0
              },
              "error": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "failed",
                  "cancelled",
                  "timed_out"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "integer",
                    "not": {
                      "const": 0
                    }
                  }
                ]
              },
              "artifact_paths": {
                "maxItems": 0
              },
              "error": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reviewer",
        "at",
        "decision",
        "summary",
        "evidence",
        "subject_hashes",
        "checklist"
      ],
      "properties": {
        "kind": {
          "enum": [
            "automated",
            "human"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "decision": {
          "enum": [
            "passed",
            "changes_requested",
            "unavailable"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          },
          "minItems": 1
        },
        "subject_hashes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          },
          "minItems": 1
        },
        "checklist": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "state_file",
        "state_revision",
        "who",
        "when",
        "approval_digest",
        "input_hashes"
      ],
      "properties": {
        "stage_id": {
          "enum": [
            "script-approval",
            "owner-review"
          ]
        },
        "state_file": {
          "const": "workflow.json"
        },
        "state_revision": {
          "type": "integer",
          "minimum": 0
        },
        "who": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "type": "string",
          "format": "date-time"
        },
        "approval_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_hashes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          },
          "minItems": 1
        }
      }
    }
  },
