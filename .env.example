# Chép file này thành .env (cùng thư mục kit/) rồi điền key. .env KHÔNG commit.
# Thứ tự tìm key: biến môi trường → .env của dự án → kit/.env → kit/config.json.

# Stock miễn phí (tools/stock_media.py, tools/longform.py)
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# Epidemic Sound — nhạc nền + SFX (khách yêu cầu 100% âm thanh từ Epidemic)
EPIDEMIC_API_KEY=
